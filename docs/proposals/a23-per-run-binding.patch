+    const blank = {
+      ...CTX,
+      sourceEvent: { correlation_id: CORRELATION_VALUE, email_recipient: '  ' },
+    };
+    for (const ctx of [without, blank]) {
+      const r = one(recipientBound, bundle, ctx);
