{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verify-itisyou",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Local dev needs its own DB binding. Without it `wrangler dev` has no D1 at all,
  // and every /app request throws once the customer port is wired to the real database.
  // The id points at the staging database on purpose: `wrangler dev` uses a local
  // SQLite file by default and only touches the remote one with --remote.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verify-itisyou-db-staging",
      "database_id": "b680f037-bcf4-4fd3-85d6-ad7f37cd65a1",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_BASE_URL": "http://localhost:8787",
    "STRIPE_MODE": "test"
  },
  "env": {
    "staging": {
      "name": "verify-itisyou-staging",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_BASE_URL": "https://verify-itisyou-staging.kpleelaaravind.workers.dev",
        "STRIPE_MODE": "test"
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "none"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "verify-itisyou-db-staging",
          "database_id": "b680f037-bcf4-4fd3-85d6-ad7f37cd65a1",
          "migrations_dir": "../../migrations"
        }
      ],
      // Plan §30 disabled staging cron so a test environment could not generate recurring
      // cost. That decision is revised here, deliberately, and the reason is worth keeping.
      //
      // With no tick on staging, the half of the product that turns an accepted event into
      // a verdict -- the due-run pass, the outbox, allowance settlement, the billing
      // recovery sweep -- had never once executed on ANY deployed environment. It was
      // exercised only by tests and by production, which is to say the first real run of it
      // was always going to be in front of a customer. On 19 September 2026 three separate
      // defects of exactly that shape were found in a single afternoon, each one correct
      // code that nothing reached, and each one invisible until a real request hit a real
      // deployment. Not running the scheduler anywhere but production is the same bet.
      //
      // Every five minutes rather than production's every minute: enough to exercise the
      // path and settle a proof run in a bounded wait, a fifth of the invocations. Cron
      // triggers themselves are not billed, and each tick is bounded work over an indexed
      // query on a near-empty database.
      "triggers": { "crons": ["*/5 * * * *"] },
      "observability": { "enabled": true }
    },
    "production": {
      "name": "verify-itisyou-production",
      "workers_dev": true,
      "routes": [{ "pattern": "verify.itisyou.app", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_BASE_URL": "https://verify.itisyou.app",
        "STRIPE_MODE": "test"
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "none"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "verify-itisyou-db-production",
          "database_id": "4c95be5b-e37d-450f-84f8-fd6c9d9406f5",
          "migrations_dir": "../../migrations"
        }
      ],
      // One scheduler tick per minute drives the single indexed due-job query,
      // the outbox dispatcher and bounded retention deletes. Plan §22.
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
