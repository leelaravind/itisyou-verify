{
  "name": "itisyou-verify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:report": "node scripts/build-test-report.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "verify:cases": "node scripts/verify-test-cases.mjs",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @verify/app dev",
    "migrate:local": "node scripts/migrate.mjs --env local",
    "migrate:staging": "node scripts/migrate.mjs --env staging",
    "migrate:production": "node scripts/migrate.mjs --env production",
    "release:staging": "node scripts/release.mjs --env staging",
    "release:production": "node scripts/release.mjs --env production",
    "test:security": "vitest run tests/security",
    "verify:story": "node scripts/verify-story.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.20.3",
    "eslint": "^9.18.0",
    "hono": "^4.13.8",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
