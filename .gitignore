# --- Secrets & credentials (never commit) ---
.env
.env.*
!.env.example
*.env
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
wrangler.local.*
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
credentials*.json
!package.json

# --- Private operational records (kept outside repo; guard anyway) ---
private/
ops-private/
checkpoints-private/
*.private.md
*.private.json

# --- Test artifacts that may capture sessions/PII ---
playwright/.auth/
storage-state*.json
test-results/
playwright-report/
blob-report/
**/*.trace.zip
**/videos/
**/screenshots-private/

# --- Build output & caches ---
node_modules/
dist/
build/
.out/
coverage/
.turbo/
.cache/
*.tsbuildinfo
.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Local databases / dumps ---
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
